   </rdf:Seq>
</dc:creator>
<dc:subject>
   <rdf:Bag>
     <rdf:li>Structural redundancy</rdf:li>
     <rdf:li>Redundancy density</rdf:li>
     <rdf:li>Green's functions</rdf:li>
     <rdf:li>Statical indeterminacy</rdf:li>
   </rdf:Bag>
</dc:subject>
