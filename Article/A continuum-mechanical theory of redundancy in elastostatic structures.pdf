<dc:title>A continuum-mechanical theory of redundancy in elastostatic structures</dc:title>
<dc:creator>
   <rdf:Seq>
     <rdf:li>Jan Gade</rdf:li>
     <rdf:li>Anton Tkachuk</rdf:li>
     <rdf:li>Malte von Scheven</rdf:li>
